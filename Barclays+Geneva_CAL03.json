    {
      "parameters": {
        "jsCode": "// === CONFIG ===\n// Keys = original field names; Values = new desired names\nconst map = {\n \"json\":\" \" ,\n  \"subject\": \"Title\",\n  \"product_category\": \"Product Category\",\n  \"createdAt\": \"Created\",\n  \"closedAt\": \"Closed\",\n  \"business_hours_reply\": \"Reply Time\",\n  \"timeToFirstReply\":\"TTFR\",\n  \"timeToClose\": \"TTC\",\n  \"firstResponseMet\":\"SLA met?\"\n};\n\n// If true => only keep keys that appear in `map` (everywhere).\n// If false => keep unmapped keys with their original names.\nconst dropUnmapped = false;\n\n// === RECURSIVE RENAME FUNCTION ===\nfunction renameRecursive(value) {\n  // If null or primitive, return as-is\n  if (value === null) return null;\n  if (typeof value !== 'object') return value;\n\n  // If it's an array, map over elements recursively\n  if (Array.isArray(value)) {\n    return value.map(elem => renameRecursive(elem));\n  }\n\n  // It's an object: process keys\n  const out = {};\n  for (const [key, val] of Object.entries(value)) {\n    // Determine new key name\n    const mappedKey = map.hasOwnProperty(key) ? map[key] : null;\n\n    if (mappedKey) {\n      // Use mapped name\n      out[mappedKey] = renameRecursive(val);\n    } else if (!dropUnmapped) {\n      // Keep original name if not dropping\n      out[key] = renameRecursive(val);\n    }\n    // if dropUnmapped === true and no mapping, we skip the key\n  }\n  return out;\n}\n\n// === n8n Function node standard return ===\nreturn items.map(item => {\n  // Guard: if item.json missing, just return it\n  if (!item.hasOwnProperty('json')) return item;\n\n  const renamed = renameRecursive(item.json);\n  // Keep other top-level fields like binary exactly as they were\n  const result = { json: renamed };\n  if (item.binary) {\n    result.binary = item.binary;\n  }\n  return result;\n});\n\n"
      },
